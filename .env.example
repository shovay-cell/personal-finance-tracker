# Серверный ключ Gemini для распознавания чеков (/api/analyze-receipt).
# Никогда не используйте префикс NEXT_PUBLIC_ для этого ключа — он попадёт в клиентский бандл.
GEMINI_API_KEY=

# Web OAuth Client ID из Google Cloud Console для бэкапа в Google Drive (scope drive.appdata).
# Это публичный идентификатор клиента, а не секрет — его можно отдавать в браузер.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
